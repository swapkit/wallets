    "directory": "packages/ui",
    "type": "git",
    "url": "git+https://github.com/swapkit/wallets.git"
  },
  "scripts": {
    "build": "NODE_ENV=production bun run ./build.ts",
    "build:clean": "rm -rf dist && bun run ./build.ts",
    "build:widget": "bun --cwd=../.. run build && NODE_OPTIONS='--max-old-space-size=8192' vite build --config vite.widget.config.ts",
    "clean": "rm -rf dist node_modules *.tsbuildinfo",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.22.1"
}
